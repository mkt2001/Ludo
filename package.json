{
  "name": "ludo-champ",
  "version": "1.0.0",
  "private": true,
  "description": "Classic four-player Ludo game packaged for Android with Capacitor",
  "scripts": {
    "copy-web": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});for(const f of ['index.html','style.css','script.js'])fs.copyFileSync(f,'www/'+f)\""
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0"
  }
}